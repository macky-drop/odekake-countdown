---
import Layout from '../layouts/Layout.astro';
---

<Layout title="おでかけカウントダウンアプリ" activeTab="home">
  <div class="home-container">
    <!-- 1段目: 日付・時刻表示 -->
    <div class="card datetime-card">
      <div class="date" id="current-date">2026年1月2日 (Thu)</div>
      <div class="time-display">
        <span class="time-hm" id="current-time-hm">00:00</span>
        <span class="time-s" id="current-time-s">:00</span>
      </div>
    </div>

    <!-- 2段目: アラーム状況 -->
    <div class="card alarm-status" id="alarm-status">
      <h2 class="section-title">アラーム</h2>
      <div id="alarm-info" class="alarm-info">
        <p class="no-alarm">未設定</p>
      </div>
    </div>

    <!-- 3段目: カウントダウン表示 -->
    <div class="card countdown-card" id="countdown-card" style="display: none;">
      <h2 class="section-title">おでかけまで</h2>
      <div class="countdown-display">
        <div class="countdown-time" id="countdown-time">00:00:00</div>
      </div>
    </div>

    <!-- 4段目: 天気情報 -->
    <div class="card weather-card">
      <h2 class="section-title">天気情報</h2>
      <div id="weather-info" class="weather-info">
        <div class="loading">読み込み中...</div>
      </div>
      <div class="location-selector">
        <select id="location-select" class="location-select">
          <option value="gps">現在地 (GPS)</option>
          <option value="35.6762,139.6503">東京</option>
          <option value="34.6937,135.5023">大阪</option>
          <option value="35.0116,135.7681">京都</option>
          <option value="35.4437,139.6380">横浜</option>
          <option value="43.0642,141.3469">札幌</option>
          <option value="33.5904,130.4017">福岡</option>
          <option value="26.2124,127.6809">那覇</option>
        </select>
      </div>
    </div>
  </div>

  <style>
    .home-container {
      max-width: 600px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .card {
      padding: 1rem;
    }

    /* 1段目: 日付・時刻 */
    .datetime-card {
      text-align: center;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
      color: white;
    }

    .date {
      font-size: 1rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    .time-display {
      display: flex;
      justify-content: center;
      align-items: baseline;
      font-variant-numeric: tabular-nums;
    }

    .time-hm {
      font-size: 3rem;
      font-weight: 700;
      line-height: 1;
    }

    .time-s {
      font-size: 1.5rem;
      font-weight: 600;
      margin-left: 0.1rem;
    }

    /* 2段目: アラーム */
    .alarm-status {
      cursor: pointer;
      transition: background 0.2s;
    }

    .alarm-status:hover {
      background: #f8fafc;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      text-align: center;
    }

    .alarm-info {
      text-align: center;
    }

    .no-alarm {
      color: var(--color-text-secondary);
      font-size: 0.875rem;
      margin: 0;
    }

    .alarm-details {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.875rem;
    }

    .alarm-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.4rem 0.75rem;
      background: var(--color-background);
      border-radius: 6px;
    }

    .alarm-label {
      font-weight: 600;
      color: var(--color-text-secondary);
      font-size: 0.8rem;
    }

    .alarm-time {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-primary);
    }

    /* 3段目: カウントダウン */
    .countdown-card {
      background: linear-gradient(135deg, var(--color-secondary) 0%, #059669 100%);
      color: white;
    }

    .countdown-display {
      text-align: center;
    }

    .countdown-time {
      font-size: 3rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    /* 4段目: 天気 */
    .weather-info {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      min-height: 60px;
    }

    .loading {
      color: var(--color-text-secondary);
      text-align: center;
      width: 100%;
    }

    .weather-display {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      justify-content: center;
    }

    .weather-icon {
      font-size: 2.5rem;
    }

    .weather-details {
      text-align: left;
    }

    .weather-condition {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .weather-temp {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    .location-selector {
      margin-top: 0.75rem;
    }

    .location-select {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-size: 0.875rem;
    }

    @media (max-width: 640px) {
      .home-container {
        gap: 0.5rem;
      }

      .card {
        padding: 0.75rem;
      }

      .time-hm {
        font-size: 2.5rem;
      }

      .time-s {
        font-size: 1.25rem;
      }

      .countdown-time {
        font-size: 2.5rem;
      }

      .section-title {
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
    }
  </style>

  <script>
    import type { AlarmPattern, WeatherData } from '../types';

    const WEEKDAY_EN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    // 現在時刻の更新
    function updateDateTime() {
      const now = new Date();
      const dateEl = document.getElementById('current-date');
      const timeHmEl = document.getElementById('current-time-hm');
      const timeSEl = document.getElementById('current-time-s');
      
      if (dateEl) {
        const year = now.getFullYear();
        const month = now.getMonth() + 1;
        const day = now.getDate();
        const weekday = WEEKDAY_EN[now.getDay()];
        dateEl.textContent = `${year}年${month}月${day}日 (${weekday})`;
      }
      
      if (timeHmEl && timeSEl) {
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        timeHmEl.textContent = `${hours}:${minutes}`;
        timeSEl.textContent = `:${seconds}`;
      }
    }

    // アラーム情報の表示
    function displayAlarmInfo() {
      const alarmInfoEl = document.getElementById('alarm-info');
      if (!alarmInfoEl) return;

      const stored = localStorage.getItem('alarmPatterns');
      if (!stored) {
        alarmInfoEl.innerHTML = '<p class="no-alarm">未設定</p>';
        return;
      }

      const patterns: AlarmPattern[] = JSON.parse(stored);
      const activePattern = patterns.find(p => p.isActive);

      if (!activePattern) {
        alarmInfoEl.innerHTML = '<p class="no-alarm">未設定</p>';
        return;
      }

      const wakeTimeDisplay = activePattern.wakeUpTime || 'OFF';
      
      alarmInfoEl.innerHTML = `
        <div class="alarm-details">
          <div class="alarm-item">
            <span class="alarm-label">パターン</span>
            <span>${activePattern.label}</span>
          </div>
          <div class="alarm-item">
            <span class="alarm-label">めざまし</span>
            <span class="alarm-time">${wakeTimeDisplay}</span>
          </div>
          <div class="alarm-item">
            <span class="alarm-label">おでかけ</span>
            <span class="alarm-time">${activePattern.departureTime}</span>
          </div>
        </div>
      `;

      updateCountdown(activePattern);
    }

    // カウントダウンの更新
    function updateCountdown(pattern: AlarmPattern) {
      const countdownCard = document.getElementById('countdown-card');
      const countdownTime = document.getElementById('countdown-time');
      if (!countdownCard || !countdownTime) return;

      const now = new Date();
      const [hours, minutes] = pattern.departureTime.split(':').map(Number);
      const target = new Date(now);
      target.setHours(hours, minutes, 0, 0);

      // 今日のおでかけ時刻が過ぎていたら翌日に設定
      if (target.getTime() <= now.getTime()) {
        target.setDate(target.getDate() + 1);
      }

      const diff = target.getTime() - now.getTime();
      const totalSeconds = Math.floor(diff / 1000);
      
      // 00:00:00になった瞬間（totalSeconds <= 0）
      if (totalSeconds <= 0) {
        countdownTime.textContent = '00:00:00';
        countdownCard.style.display = 'block';
        
        // 通知を1回だけ送る
        const alreadyNotified = sessionStorage.getItem('departure_notified');
        if (!alreadyNotified) {
          checkAndNotify(0);
          sessionStorage.setItem('departure_notified', 'true');
        }
        
        // アラーム後は非表示にする（翌日の計算は次の更新サイクルで）
        return;
      }

      // departure_notifiedフラグをクリア（新しいサイクル用）
      if (totalSeconds > 60) {
        sessionStorage.removeItem('departure_notified');
      }

      const hours_left = Math.floor(diff / (1000 * 60 * 60));
      const minutes_left = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds_left = Math.floor((diff % (1000 * 60)) / 1000);

      countdownTime.textContent = `${String(hours_left).padStart(2, '0')}:${String(minutes_left).padStart(2, '0')}:${String(seconds_left).padStart(2, '0')}`;
      countdownCard.style.display = 'block';

      // 通知チェック（正確なタイミング）
      pattern.notificationIntervals.forEach(interval => {
        const targetSeconds = interval * 60;
        // targetSecondsちょうど、またはtargetSeconds-1秒の時に通知
        if (totalSeconds === targetSeconds || totalSeconds === targetSeconds - 1) {
          checkAndNotify(interval);
        }
      });
    }

    // 通知処理
    function checkAndNotify(minutesLeft: number) {
      const lastNotified = sessionStorage.getItem(`notified_${minutesLeft}`);
      if (lastNotified) return;

      sessionStorage.setItem(`notified_${minutesLeft}`, 'true');

      const settings = JSON.parse(localStorage.getItem('settings') || '{"soundEnabled":true}');

      if (minutesLeft === 0) {
        // おでかけ時刻: 音楽を再生
        playAlarmMusic();

        // 音声通知（iOSでも動作するように）
        if (settings.soundEnabled && 'speechSynthesis' in window) {
          // 既存の音声を停止
          speechSynthesis.cancel();
          
          const utterance = new SpeechSynthesisUtterance('おでかけの時間です！いってらっしゃい！');
          utterance.lang = 'ja-JP';
          utterance.volume = 1.0;
          utterance.rate = 1.0;
          utterance.pitch = 1.0;
          
          // 少し遅延させて確実に再生
          setTimeout(() => {
            speechSynthesis.speak(utterance);
          }, 100);
        }

        // ビジュアルアラート
        showVisualAlert('🚶 おでかけの時間です！', 'いってらっしゃい！');
      } else {
        // カウントダウン通知
        if (settings.soundEnabled && 'speechSynthesis' in window) {
          // 既存の音声を停止
          speechSynthesis.cancel();
          
          const utterance = new SpeechSynthesisUtterance(`おでかけ${minutesLeft}分前です`);
          utterance.lang = 'ja-JP';
          utterance.volume = 1.0;
          utterance.rate = 1.0;
          utterance.pitch = 1.0;
          
          // 少し遅延させて確実に再生
          setTimeout(() => {
            speechSynthesis.speak(utterance);
          }, 100);
        }

        // ビジュアルアラート（3秒で自動消去）
        showVisualAlert('⏰ カウントダウン', `おでかけ${minutesLeft}分前です`, 3000);
      }
    }

    // アラーム音楽の再生
    function playAlarmMusic() {
      // 既存の音楽を停止
      if ((window as any).currentAlarmAudio) {
        (window as any).currentAlarmAudio.pause();
        (window as any).currentAlarmAudio.currentTime = 0;
      }

      const audio = new Audio('/sounds/alarm.mp3');
      
      // iOSでの再生を試みる
      audio.load();
      
      const tryPlay = () => {
        audio.play()
          .then(() => {
            console.log('音楽再生開始');
          })
          .catch(error => {
            console.log('音楽の自動再生が制限されています:', error);
            // フォールバック: ビープ音
            playBeepSound();
          });
      };

      audio.addEventListener('canplaythrough', tryPlay, { once: true });
      
      audio.addEventListener('error', (e) => {
        console.log('音楽ファイルが見つかりません');
        playBeepSound();
      });

      // 音量設定
      audio.volume = 0.7;
      
      // ループ再生
      audio.loop = true;

      // 30秒後に自動停止
      setTimeout(() => {
        audio.pause();
        audio.currentTime = 0;
      }, 30000);

      // グローバルに保存
      (window as any).currentAlarmAudio = audio;
    }

    // ビープ音を鳴らす（音楽ファイルがない場合のフォールバック）
    function playBeepSound() {
      try {
        const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
        
        // 3回ビープ音を鳴らす
        for (let i = 0; i < 3; i++) {
          const oscillator = audioContext.createOscillator();
          const gainNode = audioContext.createGain();

          oscillator.connect(gainNode);
          gainNode.connect(audioContext.destination);

          oscillator.frequency.value = 800;
          oscillator.type = 'sine';

          const startTime = audioContext.currentTime + (i * 0.5);
          gainNode.gain.setValueAtTime(0.3, startTime);
          gainNode.gain.exponentialRampToValueAtTime(0.01, startTime + 0.3);

          oscillator.start(startTime);
          oscillator.stop(startTime + 0.3);
        }
      } catch (error) {
        console.log('ビープ音の再生に失敗:', error);
      }
    }

    // ビジュアルアラート表示（iOS用）
    function showVisualAlert(title: string, message: string, duration: number = 0) {
      const existing = document.getElementById('visual-alert');
      if (existing) existing.remove();

      const alert = document.createElement('div');
      alert.id = 'visual-alert';
      alert.innerHTML = `
        <div style="
          position: fixed;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          background: white;
          padding: 2rem;
          border-radius: 16px;
          box-shadow: 0 20px 60px rgba(0,0,0,0.3);
          z-index: 10000;
          text-align: center;
          min-width: 280px;
          max-width: 90vw;
          animation: slideIn 0.3s ease-out;
        ">
          <div style="font-size: 3rem; margin-bottom: 1rem;">${title.split(' ')[0]}</div>
          <div style="font-size: 1.5rem; font-weight: bold; margin-bottom: 0.5rem;">${title.split(' ').slice(1).join(' ')}</div>
          <div style="font-size: 1rem; color: #666;">${message}</div>
          <button onclick="this.closest('#visual-alert').remove()" style="
            margin-top: 1.5rem;
            padding: 0.75rem 2rem;
            background: var(--color-primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
          ">確認</button>
        </div>
        <div onclick="this.closest('#visual-alert').remove()" style="
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0,0,0,0.5);
          z-index: 9999;
        "></div>
        <style>
          @keyframes slideIn {
            from {
              opacity: 0;
              transform: translate(-50%, -60%);
            }
            to {
              opacity: 1;
              transform: translate(-50%, -50%);
            }
          }
        </style>
      `;
      document.body.appendChild(alert);

      if (duration > 0) {
        setTimeout(() => {
          alert.remove();
        }, duration);
      }
    }

    // 天気情報の取得（Open-Meteo）
    async function fetchWeather() {
      const weatherInfoEl = document.getElementById('weather-info');
      const locationSelect = document.getElementById('location-select') as HTMLSelectElement;
      if (!weatherInfoEl) return;

      try {
        let lat: number, lon: number;

        if (locationSelect.value === 'gps') {
          if (!('geolocation' in navigator)) {
            throw new Error('位置情報が利用できません');
          }

          const position = await new Promise<GeolocationPosition>((resolve, reject) => {
            navigator.geolocation.getCurrentPosition(resolve, reject);
          });

          lat = position.coords.latitude;
          lon = position.coords.longitude;
        } else {
          [lat, lon] = locationSelect.value.split(',').map(Number);
        }

        // Open-Meteo API
        const response = await fetch(
          `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min&timezone=Asia/Tokyo`
        );

        if (!response.ok) throw new Error('天気情報の取得に失敗しました');

        const data = await response.json();
        
        // 天気コードをアイコンに変換
        const weatherCode = data.current.weather_code;
        const weatherIcon = getWeatherIcon(weatherCode);
        const weatherDesc = getWeatherDescription(weatherCode);
        
        const currentTemp = Math.round(data.current.temperature_2m);
        const maxTemp = Math.round(data.daily.temperature_2m_max[0]);
        const minTemp = Math.round(data.daily.temperature_2m_min[0]);

        weatherInfoEl.innerHTML = `
          <div class="weather-display">
            <div class="weather-icon">${weatherIcon}</div>
            <div class="weather-details">
              <div class="weather-condition">${weatherDesc}</div>
              <div class="weather-temp">現在: ${currentTemp}℃</div>
              <div class="weather-temp">最高: ${maxTemp}℃ / 最低: ${minTemp}℃</div>
            </div>
          </div>
        `;
      } catch (error) {
        weatherInfoEl.innerHTML = `
          <div class="weather-display">
            <div class="weather-details">
              <div class="weather-condition">天気情報を取得できませんでした</div>
            </div>
          </div>
        `;
      }
    }

    // 天気コードからアイコンを取得
    function getWeatherIcon(code: number): string {
      if (code === 0) return '☀️';
      if (code <= 3) return '⛅';
      if (code <= 48) return '🌫️';
      if (code <= 67) return '🌧️';
      if (code <= 77) return '🌨️';
      if (code <= 82) return '🌧️';
      if (code <= 86) return '🌨️';
      return '⛈️';
    }

    // 天気コードから説明を取得
    function getWeatherDescription(code: number): string {
      if (code === 0) return '快晴';
      if (code === 1) return '晴れ';
      if (code === 2) return '一部曇り';
      if (code === 3) return '曇り';
      if (code <= 48) return '霧';
      if (code <= 67) return '雨';
      if (code <= 77) return '雪';
      if (code <= 82) return '強い雨';
      if (code <= 86) return '強い雪';
      return '雷雨';
    }

    // アラーム設定エリアのクリックイベント
    const alarmStatus = document.getElementById('alarm-status');
    if (alarmStatus) {
      alarmStatus.addEventListener('click', () => {
        window.location.href = '/alarms';
      });
    }

    // 地域選択の変更イベント
    const locationSelect = document.getElementById('location-select');
    if (locationSelect) {
      locationSelect.addEventListener('change', fetchWeather);
    }

    // iOS用: 音声・音楽の初期化（ユーザータップで有効化）
    let audioInitialized = false;
    function initializeAudioForIOS() {
      if (audioInitialized) return;
      
      // 音声合成のウォームアップ
      if ('speechSynthesis' in window) {
        const utterance = new SpeechSynthesisUtterance('');
        utterance.volume = 0;
        speechSynthesis.speak(utterance);
      }
      
      // オーディオコンテキストのウォームアップ
      try {
        const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
        audioContext.resume();
      } catch (e) {
        console.log('AudioContext初期化:', e);
      }
      
      audioInitialized = true;
      console.log('音声・音楽が有効化されました');
    }

    // 画面タップで音声を有効化（iOS対応）
    document.body.addEventListener('touchstart', initializeAudioForIOS, { once: true });
    document.body.addEventListener('click', initializeAudioForIOS, { once: true });

    // 初期化
    updateDateTime();
    displayAlarmInfo();
    fetchWeather();

    // 通知許可をリクエスト
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }

    // 定期更新
    setInterval(() => {
      updateDateTime();
      const stored = localStorage.getItem('alarmPatterns');
      if (stored) {
        const patterns: AlarmPattern[] = JSON.parse(stored);
        const activePattern = patterns.find(p => p.isActive);
        if (activePattern) {
          updateCountdown(activePattern);
        }
      }
    }, 1000);
  </script>
</Layout>
